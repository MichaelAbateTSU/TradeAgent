# TradeAgent is paper-only. There is no live mode or broker credential in this release.
TRADEAGENT_MODE=paper
TRADEAGENT_TRADING_ENABLED=true
TRADEAGENT_DATABASE_PATH=data/tradeagent.db
TRADEAGENT_BROKER__STARTING_CASH=100000
TRADEAGENT_BROKER__SLIPPAGE_BPS=2
TRADEAGENT_BROKER__COMMISSION_BPS=1
TRADEAGENT_STRATEGY__FAST_WINDOW=20
TRADEAGENT_STRATEGY__SLOW_WINDOW=50
TRADEAGENT_STRATEGY__EXECUTION_DELAY_BARS=1
TRADEAGENT_STRATEGY__TARGET_WEIGHT=0.02
TRADEAGENT_RISK__MAX_GROSS_EXPOSURE=0.50
TRADEAGENT_RISK__MAX_POSITION_EXPOSURE=0.05
TRADEAGENT_RISK__MAX_ORDER_EXPOSURE=0.02
TRADEAGENT_RISK__MAX_DAILY_LOSS=0.01
TRADEAGENT_RISK__MAX_DRAWDOWN=0.015

# Optional historical market-data access. Keep real values only in an untracked .env
# or an operating-system secret store.
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
ALPACA_FEED=iex
