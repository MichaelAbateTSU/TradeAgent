# TradeAgent is paper-only. There is no live mode or broker credential in this release.
TRADEAGENT_MODE=paper
TRADEAGENT_TRADING_ENABLED=true
TRADEAGENT_DATABASE_PATH=data/tradeagent.db
TRADEAGENT_DATABASE_URL=sqlite:///data/tradeagent-v2.db
TRADEAGENT_BROKER__STARTING_CASH=100000
TRADEAGENT_BROKER__SLIPPAGE_BPS=2
TRADEAGENT_BROKER__SPREAD_BPS=1
TRADEAGENT_BROKER__COMMISSION_BPS=1
TRADEAGENT_BROKER__MAX_VOLUME_PARTICIPATION=0.01
TRADEAGENT_STRATEGY__FAST_WINDOW=20
TRADEAGENT_STRATEGY__SLOW_WINDOW=50
TRADEAGENT_STRATEGY__EXECUTION_DELAY_BARS=1
TRADEAGENT_STRATEGY__TARGET_WEIGHT=0.02
TRADEAGENT_RISK__MAX_GROSS_EXPOSURE=0.50
TRADEAGENT_RISK__MAX_POSITION_EXPOSURE=0.05
TRADEAGENT_RISK__MAX_ORDER_EXPOSURE=0.02
TRADEAGENT_RISK__MAX_DAILY_LOSS=0.01
TRADEAGENT_RISK__MAX_DRAWDOWN=0.015
TRADEAGENT_RISK__MAX_VOLUME_PARTICIPATION=0.01

# Intraday mode remains disabled until an intraday strategy qualifies.
TRADEAGENT_INTRADAY__ENABLED=false
TRADEAGENT_INTRADAY__PRIMARY_BAR_MINUTES=5
TRADEAGENT_INTRADAY__CONTEXT_BAR_MINUTES=15
TRADEAGENT_INTRADAY__MINIMUM_ORDER_NOTIONAL=10
TRADEAGENT_INTRADAY__MAXIMUM_ORDER_NOTIONAL=25
TRADEAGENT_INTRADAY__MAXIMUM_POSITION_EXPOSURE=0.005
TRADEAGENT_INTRADAY__MAXIMUM_GROSS_EXPOSURE=0.01
TRADEAGENT_INTRADAY__MAXIMUM_POSITIONS=2
TRADEAGENT_INTRADAY__MAXIMUM_ROUND_TRIPS_PER_DAY=2
TRADEAGENT_INTRADAY__SYMBOL_COOLDOWN_MINUTES=30
TRADEAGENT_INTRADAY__MINIMUM_EXPECTED_EDGE_BPS=15

# Optional historical market-data access. Keep real values only in an untracked .env
# or an operating-system secret store.
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
ALPACA_FEED=iex
ALPACA_DATA_STREAM_URL=wss://stream.data.alpaca.markets/v2/iex

# Optional exactly-once round-trip email delivery.
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
EMAIL_SENDER=TradeAgent <paper@example.com>
EMAIL_RECIPIENT=
